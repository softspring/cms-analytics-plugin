{% trans_default_domain 'sfs_cms_contents' %}

{% set analytics_rows = sfs_cms_analytics_content_rows(content_entity) %}
{% set analytics_configured_rows = analytics_rows|filter(row => row.configuration.usable) %}
{% set analytics_totals = sfs_cms_analytics_content_totals(analytics_configured_rows) %}

{% embed '@SfsCms/admin/_embeds/_card.html.twig' with {
    'title': ('admin_'~content_type~'.read.routes.title')|trans,
    'analytics_rows': analytics_rows,
    'analytics_configured_rows': analytics_configured_rows,
    'analytics_totals': analytics_totals,
} %}
    {% trans_default_domain 'sfs_cms_contents' %}

    {% block title %}
        <h5 class="border-bottom border-1 border-light pb-2 mb-3 d-flex align-items-center justify-content-between gap-2">
            <span>{{ title }}</span>
            {% if not content_config.admin.routes.is_granted or is_granted(content_config.admin.routes.is_granted, content_entity) %}
                <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="{{ url('sfs_cms_admin_content_'~content_type~'_routes', {'content':content_entity.id}) }}">{{ ('admin_'~content_type~'.read.routes.edit.link')|trans }} <i class="bi bi-signpost-split"></i></a>
            {% else %}
                <a class="btn btn-sm btn-outline-secondary flex-shrink-0 disabled">{{ ('admin_'~content_type~'.read.routes.edit.link')|trans }} <i class="bi bi-signpost-split"></i></a>
            {% endif %}
        </h5>
    {% endblock %}

    {% block content %}
        {% if not content_entity.publishedVersion %}
            <div class="alert alert-warning" role="alert">
                {{ ('admin_'~content_type~'.read.routes.not_published_warning')|trans }}
            </div>
        {% else %}
            {% set routeLocales = sfs_cms_check_content_locales_and_routes(content_entity) %}
            {% for missingLocale in routeLocales.missing_route_locales %}
                <div class="alert alert-warning" role="alert">
                    {{ ('admin_'~content_type~'.read.routes.missing_locale')|trans({'%missingLocale%': missingLocale}) }}
                </div>
            {% endfor %}
        {% endif %}

        <ul class="list-unstyled d-grid gap-2 mb-0">
            {% for route in content_entity.routes %}
                {% for site in route.sites %}
                    {% for path in route.paths %}
                        <li class="row g-2 align-items-center">
                            <div class="col text-truncate">
                                <span class="fw-semibold">{{ site|sfs_cms_site_name }}:</span>
                                <a href="{{ sfs_cms_route_path_url(path, site) }}" target="_blank" rel="noopener noreferrer">{{ sfs_cms_route_path_path(path, site) }}</a>
                            </div>
                            {% if path.cacheTtl and not (contentCacheLastModifiedEnabled|default(false)) %}
                                <div class="col-auto">
                                    <span class="badge text-bg-secondary">TTL {{ path.cacheTtl }}</span>
                                </div>
                            {% endif %}
                            <div class="col-auto">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ sfs_cms_route_path_url(path, site) }}" target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    <span class="visually-hidden">{{ sfs_cms_route_path_path(path, site) }}</span>
                                </a>
                            </div>
                        </li>
                    {% endfor %}
                {% endfor %}
            {% endfor %}
        </ul>

        {% if analytics_configured_rows is not empty %}
            <div class="border-top border-1 border-light mt-3 pt-3">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                    <h6 class="mb-0">{{ 'read_routes.analytics.title'|trans({}, 'sfs_cms_analytics') }}</h6>
                    <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="{{ url('sfs_cms_admin_content_'~content_type~'_statistics', {'content': content_entity.id}) }}">
                        {{ 'read_routes.analytics.view.link'|trans({}, 'sfs_cms_analytics') }} <i class="bi bi-link-45deg"></i>
                    </a>
                </div>

                <div class="border rounded p-2 small">
                    <div class="text-muted">{{ 'read_routes.analytics.last_30_days'|trans({}, 'sfs_cms_analytics') }}</div>
                    <div class="fw-bold">
                        {{ 'read_routes.analytics.summary'|trans({
                            '%visits%': analytics_totals.visits|default(0)|number_format(0, '.', ','),
                            '%visitors%': analytics_totals.visitors|default(0)|number_format(0, '.', ',')
                        }, 'sfs_cms_analytics') }}
                    </div>
                </div>
            </div>
        {% endif %}
    {% endblock %}
{% endembed %}
